{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/create-checkout.js": {
      "maxDuration": 30
    },
    "api/success.js": {
      "maxDuration": 15
    },
    "api/generate-pdf.js": {
      "maxDuration": 60
    },
    "api/webhook.js": {
      "maxDuration": 30
    },
    "api/cleanup.js": {
      "maxDuration": 60
    },
    "api/sign-upload.js": {
      "maxDuration": 10
    },
    "api/compose.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/success",
      "destination": "/api/success"
    },
    {
      "source": "/cancel",
      "destination": "/api/cancel"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com https://res.cloudinary.com; connect-src 'self' https://noustalgie.fr https://www.noustalgie.fr https://noustalgie.vercel.app https://api.cloudinary.com; worker-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(og-image.png|og-image.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}